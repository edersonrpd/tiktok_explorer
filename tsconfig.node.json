{
  "compilerOptions": {
    "target": "ES2022",
    // DOM entra pelos tipos de fetch/Response usados pelo middleware de
    // proxy do dev server (o Node 18+ expõe essas APIs globalmente).
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "src/lib/proxyTarget.ts", "src/lib/signedUrl.ts"]
}
